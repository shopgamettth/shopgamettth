@model IEnumerable<Coffee.DTO.CategoryDTO>
@using System
@using System.Linq
@{
    ViewData["Title"] = "Default";
    var selectedCategory = ViewContext.HttpContext.Request.Query["loai"].ToString();
}

<div class="category-horizontal-wrapper mb-4">
    <div class="d-flex align-items-center mb-3">
        <h4 class="text-white fw-bold m-0"><i class="fas fa-gamepad text-warning me-2"></i> DANH MỤC GAME</h4>
        <span class="badge bg-danger ms-3 rounded-pill">@Model.Count() Game</span>
    </div>

    <div class="category-scroll-container">
        <a asp-controller="Products"
           asp-action="Index"
           asp-route-loai="0"
           class="category-btn @(selectedCategory == "0" ? "active" : "")">
            <i class="fas fa-th-large me-2"></i> Tất cả
        </a>

        @foreach (var c in Model)
        {
            var isActive = string.Equals(selectedCategory, c.Id.ToString(), StringComparison.OrdinalIgnoreCase);
            
            <a asp-controller="Products"
               asp-action="Index"
               asp-route-loai="@c.Id"
               class="category-card @(isActive ? "active" : "")">
                <div class="category-image-wrapper">
                    @if (!string.IsNullOrEmpty(c.ImageUrl))
                    {
                        <img src="@c.ImageUrl" alt="@c.Name" />
                    }
                    else
                    {
                        <i class="fas fa-gamepad"></i>
                    }
                </div>
                <span class="category-name">@c.Name</span>
            </a>
        }
    </div>
</div>

<style>
    .category-scroll-container {
        display: flex;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 10px;
        scrollbar-width: thin;
        scrollbar-color: #ff0055 transparent;
    }
    
    .category-scroll-container::-webkit-scrollbar {
        height: 6px;
    }
    .category-scroll-container::-webkit-scrollbar-thumb {
        background: #ff0055;
        border-radius: 10px;
    }

    .category-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #1e2235;
        padding: 15px;
        border-radius: 12px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.3s ease;
        min-width: 140px;
    }

    .category-card:hover {
        background: #2a2e45;
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .category-card.active {
        background: linear-gradient(135deg, #ff0055 0%, #ff4d4f 100%);
        border-color: #ff0055;
        box-shadow: 0 4px 15px rgba(255, 0, 85, 0.3);
    }

    .category-image-wrapper {
        width: 100px;
        height: 100px;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.2);
        margin-bottom: 10px;
    }

    .category-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .category-image-wrapper i {
        font-size: 40px;
        color: #a0a5ba;
    }

    .category-card.active .category-image-wrapper i {
        color: #fff;
    }

    .category-name {
        color: #a0a5ba;
        font-weight: 600;
        font-size: 14px;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 120px;
    }

    .category-card.active .category-name {
        color: #fff;
    }
    
    .category-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 147px;
        white-space: nowrap;
        background: #1e2235;
        color: #a0a5ba;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.3s ease;
    }

    .category-btn:hover {
        color: #fff;
        background: #2a2e45;
        transform: translateY(-5px);
    }

    .category-btn.active {
        background: linear-gradient(135deg, #ff0055 0%, #ff4d4f 100%);
        color: #fff;
        border-color: #ff0055;
        box-shadow: 0 4px 15px rgba(255, 0, 85, 0.3);
    }
</style>

<section class="coffee-hero">
    <div id="blog-carousel" class="carousel slide overlay-bottom" data-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/img/banner-lq.png" style="height: 100vh; object-fit: cover;" alt="Liên Quân Mobile">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <span class="coffee-hero-kicker">CHUYÊN CUNG CẤP ACC GAME VIP</span>
                    <h2 class="text-primary font-weight-medium m-0">Tài khoản Liên Quân chất lượng</h2>
                    <h1 class="display-1 text-white m-0" style="text-shadow: 0 0 15px rgba(240,193,75,0.7);">GAME STORE</h1>
                    <p class="coffee-hero-copy">
                        Từ tài khoản Liên Quân siêu vip, full tướng, skin, tất cả đều có tại đây với giao dịch tự động 24/7.
                    </p>
                    <div class="coffee-hero-actions">
                        <a asp-controller="Products" asp-action="Index" class="btn coffee-hero-primary">Mua Acc Ngay</a>
                        <a asp-controller="Home" asp-action="Service" class="btn coffee-hero-secondary">Nạp Thẻ</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/img/banner-ff.png" style="height: 100vh; object-fit: cover;" alt="Free Fire">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <span class="coffee-hero-kicker">GIAO DỊCH TỰ ĐỘNG - UY TÍN 100%</span>
                    <h2 class="text-primary font-weight-medium m-0">Acc Free Fire Cực Phẩm</h2>
                    <h1 class="display-1 text-white m-0" style="text-shadow: 0 0 15px rgba(240,193,75,0.7);">SIÊU KHỦNG</h1>
                    <p class="coffee-hero-copy">
                        Nick Free Fire VIP, nhiều súng xịn, hành động hiếm. Duyệt tài khoản ngay sau khi thanh toán.
                    </p>
                    <div class="coffee-hero-actions">
                        <a asp-controller="Products" asp-action="Index" class="btn coffee-hero-primary">Khám phá Shop</a>
                        <a asp-controller="Home" asp-action="Contact" class="btn coffee-hero-secondary">Liên hệ Hỗ trợ</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/img/banner-esports.png" style="height: 100vh; object-fit: cover;" alt="Game Esports">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <span class="coffee-hero-kicker">BẢO HÀNH TRỌN ĐỜI</span>
                    <h2 class="text-primary font-weight-medium m-0">Đa dạng thể loại, giá rẻ bất ngờ</h2>
                    <h1 class="display-1 text-white m-0" style="text-shadow: 0 0 15px rgba(240,193,75,0.7);">GIÁ TRỊ THẬT</h1>
                    <p class="coffee-hero-copy">
                        Hỗ trợ nạp game chiết khấu cao, tự động 100%. Bảo vệ quyền lợi người mua tuyệt đối.
                    </p>
                    <div class="coffee-hero-actions">
                        <a asp-controller="Products" asp-action="Index" class="btn coffee-hero-primary">Xem Tất Cả Acc</a>
                    </div>
                </div>
            </div>
        </div>

        <a class="carousel-control-prev" href="#blog-carousel" data-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </a>
        <a class="carousel-control-next" href="#blog-carousel" data-slide="next">
            <span class="carousel-control-next-icon"></span>
        </a>
    </div>
</section>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var showHomeHero = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <title>shop game</title>
    <!-- Open Graph / Facebook / Zalo Sharing Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="shop game - Thiên Mệnh Lạc Hồng" />
    <meta property="og:description" content="Hệ thống mua bán tài khoản game Thiên Mệnh Lạc Hồng uy tín, bảo mật và tự động 100%." />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/banner_thien_menh.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:site_name" content="shop game" />

    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Free Website Template" name="keywords">
    <meta content="Free Website Template" name="description">

    <partial name="_favicon" />

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;400&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <link href="~/css/style.min.css" rel="stylesheet">
    <link href="~/css/site-header.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/game-shop.css" rel="stylesheet" asp-append-version="true">

    @RenderSection("Css", required: false)
</head>
<body class="coffee-shell coffee-shell-home">
    <div id="bg-3d"></div>
    <partial name="~/Views/Shared/_Header.cshtml" />

    @if (showHomeHero)
    {
        <partial name="_HomeHero" />
    }

    <main id="main-content">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/lib/tempusdominus/js/moment.min.js"></script>
    <script src="~/lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="~/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>

    <script src="~/js/main.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script> <!-- thêm vào đây -->

    <script src="~/js/site-cart-count.js" asp-append-version="true"></script>
    <script src="~/js/Products/Products.js" asp-append-version="true"></script>
    <script src="~/js/toast/toast.js"></script>

    <script>
        // 3D Parallax Effect for Phoenix Background
        $(window).scroll(function() {
            var scrollPos = $(this).scrollTop();
            // Scale and TranslateZ effect to simulate flying in/out
            var scale = 1 + (scrollPos * 0.0005);
            var rotateX = scrollPos * 0.01;
            $('#bg-3d').css({
                'transform': 'scale(' + scale + ') translate3d(0, ' + (scrollPos * 0.1) + 'px, 0) rotateX(' + rotateX + 'deg)'
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

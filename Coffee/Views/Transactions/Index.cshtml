@model IEnumerable<Coffee.Models.Transaction>
@{
    Layout = "_ProductsCoffee";
    ViewData["Title"] = "Lịch sử Giao Dịch";
}

<div class="container py-4 py-lg-5" style="margin-top: 100px;">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <h2 class="mb-4 text-white">Lịch Sử Nạp & Tiêu Tiền</h2>
            
            <div class="card bg-dark border-0 shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0">
                            <thead class="text-uppercase text-muted" style="font-size: 0.85rem;">
                                <tr>
                                    <th class="py-3 px-4">Thời Gian</th>
                                    <th class="py-3 px-4">Nội Dung</th>
                                    <th class="py-3 px-4 text-right">Số Tiền (VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var t in Model)
                                    {
                                        <tr>
                                            <td class="py-3 px-4 align-middle text-muted">@Coffee.Helper.AppTimeHelper.ConvertTo(t.CreatedAt, Coffee.Util.TimeZoneConstants.Vietnam).ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="py-3 px-4 align-middle">@t.Note</td>
                                            <td class="py-3 px-4 align-middle text-right">
                                                @if (t.Amount > 0)
                                                {
                                                    <span class="text-success fw-bold">+@t.Amount.ToString("N0")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">@t.Amount.ToString("N0")</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-5 text-muted">Bạn chưa có giao dịch nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

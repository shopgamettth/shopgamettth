@model IEnumerable<Coffee.Models.GameItemOrder>
@{
    ViewData["Title"] = "Đơn Nạp Game";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5" style="min-height: 70vh;">
    <h2 class="text-white mb-4">Quản Lý Đơn Nạp Game</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="table-responsive bg-dark rounded p-3">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>Người mua</th>
                    <th>Game & Gói</th>
                    <th>ID In-game</th>
                    <th>Số tiền</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@(order.User?.UserName ?? "N/A")</td>
                        <td>
                            @if(order.GameItemPackage != null && order.GameItemPackage.Game != null)
                            {
                                <span class="badge bg-primary">@order.GameItemPackage.Game.Name</span>
                                <br />
                                <span class="text-info fw-bold">@order.GameItemPackage.PackageName</span>
                            }
                        </td>
                        <td class="text-warning fw-bold">@order.PlayerId</td>
                        <td>@(order.GameItemPackage?.Price.ToString("N0") ?? "0") đ</td>
                        <td>
                            @if(order.CreatedAt.HasValue)
                            {
                                @order.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                        </td>
                        <td>
                            @if (order.Status == 0)
                            {
                                <span class="badge bg-warning text-dark">Chờ duyệt</span>
                            }
                            else if (order.Status == 1)
                            {
                                <span class="badge bg-success">Đã hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã Hủy/Hoàn tiền</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (order.Status == 0)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline" onsubmit="return confirm('Xác nhận Đã nạp thành công?');">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="status" value="1" />
                                    <button type="submit" class="btn btn-sm btn-success">Hoàn Thành</button>
                                </form>
                                <form asp-action="UpdateStatus" method="post" class="d-inline" onsubmit="return confirm('Hủy đơn và hoàn tiền cho khách?');">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="status" value="2" />
                                    <button type="submit" class="btn btn-sm btn-danger">Hủy & Hoàn Tiền</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model Coffee.Models.Game
@using Coffee.Data
@inject CoffeeShopDbContext DbContext
@{
    ViewData["Title"] = "Nạp " + Model.Name;
    Layout = "_ProductsCoffee";
    
    var currentUserName = User.Identity?.Name;
    var user = currentUserName != null ? DbContext.Users.FirstOrDefault(u => u.UserName == currentUserName) : null;
    var userBalance = user?.Balance ?? 0;
}

<div class="container mt-4 mb-5" style="min-height: 70vh;">
    <div class="row">
        <!-- Thông tin Game -->
        <div class="col-md-4 mb-4">
            <div class="bg-dark text-white rounded p-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-game.jpg" : Model.ImageUrl)" 
                     alt="@Model.Name" 
                     class="img-fluid rounded mb-3" 
                     style="max-height: 200px; object-fit: cover;" />
                
                <h3 class="text-warning fw-bold">@Model.Name</h3>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted mt-2">@Model.Description</p>
                }
                
                <hr class="border-secondary" />
                <div class="text-start mt-3">
                    <p><strong>Tài khoản của bạn:</strong> @(currentUserName ?? "Chưa đăng nhập")</p>
                    <p><strong>Số dư hiện tại:</strong> <span class="text-warning fw-bold">@userBalance.ToString("N0") VNĐ</span></p>
                </div>
                
                @if (user == null)
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary w-100 mt-3">Đăng nhập để mua</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Service" class="btn btn-outline-info w-100 mt-3">Nạp thêm tiền</a>
                }
            </div>
        </div>

        <!-- Form Nạp -->
        <div class="col-md-8">
            <div class="bg-dark p-4 rounded text-white">
                <h4 class="mb-4">Chọn gói vật phẩm</h4>
                
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @if (Model.GameItemPackages == null || !Model.GameItemPackages.Any())
                {
                    <p class="text-muted">Game này hiện chưa có gói vật phẩm nào.</p>
                }
                else
                {
                    <form asp-action="Purchase" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">1. Nhập ID hoặc Tên Nhân Vật trong Game <span class="text-danger">*</span></label>
                            <input type="text" name="playerId" class="form-control text-dark" required placeholder="Ví dụ: 123456789 hoặc TenNhanVat..." />
                            <small class="text-muted">Vui lòng nhập chính xác để Admin nạp đúng tài khoản.</small>
                        </div>
                        
                        <label class="form-label fw-bold">2. Chọn Gói Cần Mua <span class="text-danger">*</span></label>
                        <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                            @foreach (var pkg in Model.GameItemPackages.OrderBy(p => p.Price))
                            {
                                <div class="col">
                                    <input type="radio" class="btn-check" name="packageId" id="pkg_@pkg.Id" value="@pkg.Id" autocomplete="off" required>
                                    <label class="btn btn-outline-warning w-100 text-start p-3 d-flex align-items-center" for="pkg_@pkg.Id">
                                        @if (!string.IsNullOrEmpty(pkg.ImageUrl))
                                        {
                                            <img src="@pkg.ImageUrl" style="width: 40px; height: 40px; object-fit: contain; margin-right: 15px;" />
                                        }
                                        else
                                        {
                                            <i class="fas fa-gem fa-2x text-warning me-3"></i>
                                        }
                                        <div>
                                            <div class="fw-bold fs-5">@pkg.PackageName</div>
                                            <div class="text-white">@pkg.Price.ToString("N0") VNĐ</div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="text-end">
                            @if (user == null)
                            {
                                <button type="button" class="btn btn-secondary px-5 py-2" disabled>Vui lòng đăng nhập</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-danger px-5 py-2 fw-bold fs-5" onclick="return confirm('Bạn có chắc chắn muốn mua gói này? Tiền sẽ bị trừ trực tiếp vào số dư.');">
                                    <i class="fas fa-shopping-cart"></i> THÁNH TOÁN NGAY
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .btn-check:checked + .btn-outline-warning {
        background-color: #ffc107;
        color: #000;
        border-color: #ffc107;
    }
    .btn-outline-warning {
        border-width: 2px;
        transition: all 0.2s;
    }
    .btn-outline-warning:hover {
        transform: translateY(-2px);
    }
</style>

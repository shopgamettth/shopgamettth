@model Coffee.Models.Game
@{
    ViewData["Title"] = "Chỉnh sửa Game";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5" style="min-height: 70vh;">
    <h2 class="text-white mb-4">Chỉnh Sửa Game</h2>

    <div class="bg-dark p-4 rounded col-md-6 text-white">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="ImagePublicId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên Game <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control text-dark" required />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả ngắn</label>
                <textarea asp-for="Description" class="form-control text-dark" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Ảnh đại diện hiện tại</label>
                <div>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" style="width: 100px; border-radius: 10px;" />
                    }
                    else
                    {
                        <p class="text-muted">Chưa có ảnh</p>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Cập nhật ảnh mới (để trống nếu giữ nguyên)</label>
                <input type="file" name="ImageFile" class="form-control text-dark" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-warning">Cập Nhật</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
        </form>
    </div>
</div>

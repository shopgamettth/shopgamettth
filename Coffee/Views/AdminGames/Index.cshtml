@model IEnumerable<Coffee.Models.Game>
@{
    ViewData["Title"] = "Quản lý Game Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5" style="min-height: 70vh;">
    <h2 class="text-white mb-4">Quản Lý Loại Item (Game)</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-danger">Thêm Game Mới</a>
    </div>

    <div class="table-responsive bg-dark rounded p-3">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ảnh</th>
                    <th>Tên Game</th>
                    <th>Mô Tả</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 10px;" />
                            }
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td class="text-end">
                            <a asp-action="Packages" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Quản lý Gói Item</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa game này? Tất cả các gói và đơn hàng nạp item của game này cũng sẽ bị xóa!');">
                                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

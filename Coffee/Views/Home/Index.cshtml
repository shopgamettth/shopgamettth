@model IEnumerable<Coffee.DTO.ProductDTO>
@{
    ViewData["Title"] = "Trang Chủ";
}
@section Css {
    <link rel="stylesheet" href="~/css/Products/product.css" />
    <style>
        .home-product-carousel .owl-nav {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }
        .home-product-carousel .owl-nav button {
            background: var(--primary) !important;
            color: #121212 !important;
            width: 40px;
            height: 40px;
            border-radius: 50% !important;
            margin: 0 10px;
            font-size: 20px !important;
            transition: all 0.3s;
        }
        .home-product-carousel .owl-nav button:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary);
        }
        .product-card {
            background: #1e1e1e !important;
            border: 1px solid #333 !important;
            border-radius: 15px !important;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(240, 193, 75, 0.3) !important;
            border-color: var(--primary) !important;
        }
        
        @keyframes text-pulse-glow {
            0% {
                text-shadow: 0 0 10px rgba(240, 193, 75, 0.5);
                transform: scale(1);
            }
            50% {
                text-shadow: 0 0 20px rgba(240, 193, 75, 1), 0 0 30px rgba(240, 193, 75, 0.8);
                transform: scale(1.05);
            }
            100% {
                text-shadow: 0 0 10px rgba(240, 193, 75, 0.5);
                transform: scale(1);
            }
        }
        
        .animated-title {
            animation: text-pulse-glow 1.5s infinite ease-in-out;
            display: inline-block;
        }
    </style>
}

<!-- Featured Accounts Start -->
<div class="container-fluid pt-5 pb-3">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="text-primary mb-3 animated-title">🎮 TÀI KHOẢN HIỆN CÓ</h1>
            <p class="text-white">Chọn ngay một nick xịn xò để chiến thôi nào</p>
        </div>
        <div class="owl-carousel home-product-carousel">
            @foreach (var item in Model)
            {
                <div class="card h-100 product-card mx-2">
                    <div class="position-relative overflow-hidden" style="height:200px;">
                        <img src="@item.ImageUrl" class="card-img-top w-100 h-100 object-fit-cover" alt="@item.ProductName">
                        <div class="product-overlay d-flex align-items-center justify-content-center" style="position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); opacity:0; transition:0.3s;">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary rounded-pill py-2 px-4">
                                <i class="fas fa-eye mr-2"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-4 text-center">
                        <h5 class="text-white mb-3 text-truncate" style="font-size: 1.1rem;">@item.ProductName</h5>
                        <h4 class="text-primary mb-3">@item.Price.ToString("N0") đ</h4>
                        @if (item.IsSold)
                        {
                            <span class="badge bg-secondary p-2 px-3 w-100">Đã bán</span>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between">
                                <button class="btn btn-outline-primary btn-add-cart w-100 mr-1" data-productid="@item.Id">
                                    <i class="fas fa-cart-plus"></i> Thêm giỏ
                                </button>
                                <form asp-controller="Checkout" asp-action="BuyNow" method="get" class="w-100 ml-1">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary w-100">Mua ngay</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary py-2 px-4 rounded-pill">
                Xem tất cả tài khoản <i class="fas fa-arrow-right ml-2"></i>
            </a>
        </div>
    </div>
</div>
<!-- Featured Accounts End -->

<!-- About Start -->
@await Html.PartialAsync("_About")
<!-- About End -->

<!-- Promotion Modal -->
<div class="modal fade" id="promoModal" tabindex="-1" role="dialog" aria-labelledby="promoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="background: rgba(30, 30, 30, 0.95); border: 2px solid var(--primary); border-radius: 15px; box-shadow: 0 0 20px rgba(240, 193, 75, 0.5);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-primary font-weight-bold" id="promoModalLabel" style="font-size: 1.5rem; text-shadow: 0 0 10px rgba(240, 193, 75, 0.5);">🔥 SIÊU KHUYẾN MÃI 🔥</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="text-shadow: none; opacity: 1;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center pt-2 pb-4">
                <img src="~/img/banner-ff.png" alt="Promo" class="img-fluid rounded mb-3" style="max-height: 150px; object-fit: cover; width: 100%; border: 1px solid #444;" />
                <h4 class="text-white mb-3">Siêu Hot: Giảm giá các nick game lên đến <span class="text-primary" style="font-size: 2rem; font-weight: bold;">30%</span>!</h4>
                <p class="text-light mb-0">🎉 Tăng giá trị nạp kim cương, quân huy từ ngày <strong>25/05 đến 30/05</strong>. Nhanh tay chớp lấy cơ hội ngàn vàng này!</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-primary rounded-pill px-5 py-2 font-weight-bold" data-dismiss="modal" style="box-shadow: 0 0 15px rgba(240, 193, 75, 0.5);">Tuyệt Vời!</button>
            </div>
        </div>
    </div>
</div>
<!-- Promotion Modal End -->

@section Scripts {
    <script>
        $(document).ready(function () {
            // Show promotion modal on load
            if (!sessionStorage.getItem('promoShown')) {
                setTimeout(function() {
                    $('#promoModal').appendTo('body').modal('show');
                    sessionStorage.setItem('promoShown', 'true');
                }, 1000);
            }

            $('.home-product-carousel').owlCarousel({
                autoplay: true,
                smartSpeed: 1000,
                margin: 20,
                dots: false,
                loop: true,
                nav: true,
                navText: [
                    '<i class="fa fa-angle-left" aria-hidden="true"></i>',
                    '<i class="fa fa-angle-right" aria-hidden="true"></i>'
                ],
                responsive: {
                    0: { items: 1 },
                    576: { items: 2 },
                    768: { items: 3 },
                    992: { items: 4 }
                }
            });

            // Handle hover effect on product image overlay
            $('.product-card').hover(
                function() { $(this).find('.product-overlay').css('opacity', '1'); },
                function() { $(this).find('.product-overlay').css('opacity', '0'); }
            );
        });
    </script>
}

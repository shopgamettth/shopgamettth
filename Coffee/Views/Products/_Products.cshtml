@model IEnumerable<Coffee.DTO.ProductDTO>

<div class="container py-5">

    <!-- TITLE -->
    <div class="text-center mb-4 mt-2">
        <h2 class="game-title-hot animated-title">🎮 Tài Khoản Hiện Có</h2>
        <p class="text-muted">Chọn ngay một nick xịn xò để chiến thôi nào</p>
    </div>

    <!-- SORTING & FILTER BAR -->
    <div class="d-flex justify-content-end mb-4">
        <form method="get" action="@Url.Action(ViewContext.RouteData.Values["action"].ToString())" class="d-flex align-items-center" id="sortForm">
            @if (ViewBag.Query != null)
            {
                <input type="hidden" name="query" value="@ViewBag.Query" />
            }
            @if (ViewBag.Loai != null)
            {
                <input type="hidden" name="loai" value="@ViewBag.Loai" />
            }
            <label class="text-light me-2 fw-bold text-nowrap" style="margin-right: 10px;">Sắp xếp theo:</label>
            <select name="sortOrder" class="form-select bg-dark text-white border-secondary" style="width: 200px;" onchange="document.getElementById('sortForm').submit();">
                <option value="">Nổi bật nhất (Hot)</option>
                <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Giá: Thấp đến Cao</option>
                <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Giá: Cao đến Thấp</option>
            </select>
        </form>
    </div>

    <!-- GRID -->
    <div class="row g-4 products-grid">

        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">

                <div class="card product-card h-100 border-0 shadow-sm" style="@(item.IsSold ? "opacity: 0.6; filter: grayscale(50%);" : "")">

                    <!-- IMAGE -->
                    <div class="product-img-wrapper">
                        <img src="@item.ImageUrl"
                             alt="@item.ProductName">

                        <div class="product-overlay">
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="product-quick-view">
                                <i class="fas fa-eye mr-2"></i>
                                <span>Xem nhanh</span>
                            </a>
                        </div>
                    </div>

                    <!-- BODY -->
                    <div class="card-body d-flex flex-column">

                        <h6 class="fw-bold text-light mb-2">
                            @item.ProductName
                        </h6>

                        <p class="text-muted small flex-grow-1">
                            @item.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="price">
                                @item.Price.ToString("N0") đ
                            </span>
                            <span class="badge @(item.IsSold ? "bg-secondary" : "bg-success")">@(item.IsSold ? "Hết hàng" : "Còn hàng")</span>
                        </div>

                        <!-- QTY -->
                        <input type="hidden" name="quantity" form="buy-now-product-@item.Id" value="1">

                        <!-- BUTTON -->
                        <div class="d-grid gap-2">
                            @if(item.IsSold) {
                                <div class="alert alert-secondary text-center py-2 mb-0" style="font-size:0.9rem;">
                                    <strong>Đã có người mua</strong>
                                </div>
                            } else {
                                <button class="btn btn-add-cart product-action product-action-primary"
                                        data-productid="@item.Id">
                                    <i class="fas fa-cart-plus mr-2"></i>
                                    <span>Thêm vào giỏ</span>
                                </button>

                                <form id="buy-now-product-@item.Id"
                                      asp-controller="Checkout"
                                      asp-action="BuyNow"
                                      method="get"
                                      class="m-0">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="btn product-action product-action-accent w-100">
                                        <i class="fas fa-bolt mr-2"></i>
                                        <span>Mua ngay</span>
                                    </button>
                                </form>
                            }
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn product-action product-action-secondary">
                                <i class="fas fa-arrow-right mr-2"></i>
                                <span>Xem chi tiết</span>
                            </a>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    <!-- ========================= -->
    <!-- 🔥 PAGINATION XỊN -->
    <!-- ========================= -->
    @{
        int current = ViewBag.CurrentPage ?? 1;
        int total = ViewBag.TotalPages ?? 1;
        int maxDisplay = 4;

        int start = Math.Max(1, current - 1);
        int end = start + maxDisplay - 1;

        if (end > total)
        {
            end = total;
            start = Math.Max(1, end - maxDisplay + 1);
        }
    }

    <div class="d-flex justify-content-center mt-5">
        <nav>
            <ul class="pagination shadow-sm">

                <!-- PREV -->
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="@ViewContext.RouteData.Values["action"]"
                       asp-route-page="@(current - 1)"
                       asp-route-loai="@ViewBag.Loai"
                       asp-route-query="@ViewBag.Query"
                       asp-route-sortOrder="@ViewBag.SortOrder">
                        «
                    </a>
                </li>

                <!-- PAGE -->
                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == current ? "active" : "")">
                        <a class="page-link"
                           asp-action="@ViewContext.RouteData.Values["action"]"
                           asp-route-page="@i"
                           asp-route-loai="@ViewBag.Loai"
                           asp-route-query="@ViewBag.Query"
                           asp-route-sortOrder="@ViewBag.SortOrder">
                            @i
                        </a>
                    </li>
                }

                <!-- NEXT -->
                <li class="page-item @(current == total ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="@ViewContext.RouteData.Values["action"]"
                       asp-route-page="@(current + 1)"
                       asp-route-loai="@ViewBag.Loai"
                       asp-route-query="@ViewBag.Query"
                       asp-route-sortOrder="@ViewBag.SortOrder">
                        »
                    </a>
                </li>

            </ul>
        </nav>
    </div>

</div>

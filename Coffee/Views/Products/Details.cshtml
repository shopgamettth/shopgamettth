@model Coffee.DTO.ProductDTO

@{
    ViewData["Title"] = "Chi tiet san pham";
    Layout = "_ProductsCoffee";
    var productDescription = string.IsNullOrWhiteSpace(Model.Description)
        ? "Mon duoc trinh bay gon gang de ban chon nhanh, dat mon de va theo doi don hang thoai mai hon tren moi thiet bi."
        : Model.Description.Trim();
    var productImage = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Url.Content("~/img/menu-1.jpg")
        : Model.ImageUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Products/product-details.css" />
}

<section class="product-detail-page">
    <div class="container product-detail-container py-4 py-lg-5">
        <div class="product-detail-shell">
            <div class="product-detail-visual">
                <div class="product-detail-image-card">
                    <div class="product-detail-image-wrap">
                        <img id="mainImage" src="@productImage" alt="@Model.ProductName" style="width:100%; object-fit:cover; border-radius: 8px; cursor: zoom-in;" onclick="openLightbox()" />
                    </div>
                    @if(Model.ExtraImageUrls != null && Model.ExtraImageUrls.Any()) {
                        <div class="d-flex mt-3" style="overflow-x:auto; gap:10px; padding-bottom:10px;" id="thumbnailContainer">
                            <img src="@productImage" class="thumbnail-img" style="width:80px; height:80px; min-width:80px; object-fit:cover; border-radius:8px; cursor:pointer; border:2px solid #00ff88;" onclick="changeMainImage(this)" />
                            @foreach(var img in Model.ExtraImageUrls) {
                                <img src="@img" class="thumbnail-img" style="width:80px; height:80px; min-width:80px; object-fit:cover; border-radius:8px; cursor:pointer; border:2px solid transparent;" onclick="changeMainImage(this)" />
                            }
                        </div>
                    }

                    <div class="product-detail-image-footer">
                        <span class="product-detail-chip">
                            <i class="fas fa-shield-alt"></i>
                            Bảo hành 100%
                        </span>
                        <span class="product-detail-chip product-detail-chip-soft">
                            <i class="fas fa-bolt"></i>
                            Giao tài khoản tự động
                        </span>
                    </div>
                </div>
            </div>

            <div class="product-detail-content">
                <div class="product-detail-card">
                    <div class="product-detail-heading">
                        <span class="product-detail-eyebrow">Chi tiết Tài khoản</span>
                        <h1>@Model.ProductName</h1>
                        <p>@productDescription</p>
                    </div>

                    <div class="product-detail-price-row">
                        <div>
                            <div class="product-detail-label">Gia ban</div>
                            <div class="product-detail-price">@Model.Price.ToString("N0") đ</div>
                        </div>

                        <div class="product-detail-stock">
                            <i class="fas fa-check-circle"></i>
                            <span>@(Model.IsSold ? "Đã bán / Hết hàng" : "Sẵn sàng giao dịch")</span>
                        </div>
                    </div>

                    <div class="product-detail-purchase">
                        <input type="hidden" name="quantity" form="buy-now-detail-@Model.Id" value="1">

                        @if(Model.IsSold) {
                            <div class="alert alert-warning text-center">Tài khoản này đã có người mua.</div>
                        } else {
                            <div class="product-detail-actions">
                                <button class="btn btn-lg btn-add-cart product-detail-action product-action product-action-primary"
                                        data-productid="@Model.Id">
                                    <i class="fas fa-shopping-cart mr-2"></i>
                                    Them vao gio
                                </button>

                                <form id="buy-now-detail-@Model.Id"
                                      asp-controller="Checkout"
                                      asp-action="BuyNow"
                                      method="get"
                                      class="m-0">
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-lg w-100 product-detail-action product-action product-action-accent">
                                        <i class="fas fa-credit-card mr-2"></i>
                                        Thanh toan ngay
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="product-detail-backlink">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Quay lại danh sách Nick
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lightbox Overlay -->
<div id="lightboxOverlay" class="lightbox-overlay" style="display:none;" onclick="closeLightbox(event)">
    <span class="lightbox-close" onclick="closeLightbox(event)">&times;</span>
    <span class="lightbox-prev" onclick="changeLightboxImage(-1, event)">&#10094;</span>
    <img id="lightboxImage" class="lightbox-content" />
    <span class="lightbox-next" onclick="changeLightboxImage(1, event)">&#10095;</span>
</div>

@section Scripts {
    <script src="~/js/Products/Products.js" asp-append-version="true"></script>
    <script>
        let currentImageIndex = 0;
        let imageList = [];

        document.addEventListener("DOMContentLoaded", function() {
            let mainSrc = document.getElementById('mainImage').src;
            imageList.push(mainSrc);

            let thumbs = document.querySelectorAll('.thumbnail-img');
            thumbs.forEach(function(t, idx) {
                if (idx > 0) {
                    imageList.push(t.src);
                }
            });
            if(imageList.length === 1 && thumbs.length > 0) {
                imageList = Array.from(thumbs).map(t => t.src);
            }
        });

        function changeMainImage(element) {
            document.getElementById('mainImage').src = element.src;
            let thumbs = document.querySelectorAll('.thumbnail-img');
            thumbs.forEach(t => t.style.borderColor = 'transparent');
            element.style.borderColor = '#00ff88';
            
            currentImageIndex = imageList.indexOf(element.src);
            if(currentImageIndex === -1) currentImageIndex = 0;
        }

        function openLightbox() {
            let overlay = document.getElementById('lightboxOverlay');
            document.body.appendChild(overlay);
            let lbImg = document.getElementById('lightboxImage');
            lbImg.src = document.getElementById('mainImage').src;
            overlay.style.display = 'flex';
        }

        function closeLightbox(e) {
            if (e.target.id === 'lightboxOverlay' || e.target.className === 'lightbox-close') {
                document.getElementById('lightboxOverlay').style.display = 'none';
            }
        }

        function changeLightboxImage(direction, e) {
            e.stopPropagation();
            if (imageList.length === 0) return;
            
            currentImageIndex += direction;
            if (currentImageIndex >= imageList.length) {
                currentImageIndex = 0;
            } else if (currentImageIndex < 0) {
                currentImageIndex = imageList.length - 1;
            }
            
            document.getElementById('lightboxImage').src = imageList[currentImageIndex];
            
            let thumbs = document.querySelectorAll('.thumbnail-img');
            if(thumbs.length > 0 && thumbs.length === imageList.length) {
                changeMainImage(thumbs[currentImageIndex]);
            }
        }
        
        document.addEventListener('keydown', function(e) {
            let overlay = document.getElementById('lightboxOverlay');
            if (overlay && overlay.style.display === 'flex') {
                if (e.key === 'Escape') closeLightbox({target: {className: 'lightbox-close'}});
                if (e.key === 'ArrowLeft') changeLightboxImage(-1, e);
                if (e.key === 'ArrowRight') changeLightboxImage(1, e);
            }
        });
    </script>

    <style>
        .lightbox-overlay {
            position: fixed;
            z-index: 99999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.85);
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
        }
        .lightbox-content {
            max-width: 90%;
            max-height: 90%;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            animation: fadeIn 0.3s;
        }
        .lightbox-close {
            position: absolute;
            top: 20px;
            right: 35px;
            color: #fff;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            z-index: 100000;
        }
        .lightbox-close:hover {
            color: #00ff88;
        }
        .lightbox-prev, .lightbox-next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            color: #fff;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
            padding: 16px;
            transition: 0.3s;
            background-color: rgba(0,0,0,0.5);
            border-radius: 4px;
            z-index: 100000;
        }
        .lightbox-prev { left: 20px; }
        .lightbox-next { right: 20px; }
        .lightbox-prev:hover, .lightbox-next:hover {
            background-color: rgba(0,0,0,0.8);
            color: #00ff88;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
}

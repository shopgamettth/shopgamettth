@model IEnumerable<Coffee.DTO.ProductDTO>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    Layout = "_ProductsCoffee";
}

<div class="container-fluid mt-4 px-4">
    <!-- Header Thông báo tìm kiếm -->
    <div class="mb-4 text-center">
        <h2 class="game-title-hot" style="font-size: 2rem;">Kết quả tìm kiếm</h2>
        <p class="text-muted">Các tài khoản phù hợp với yêu cầu của bạn được hiển thị bên dưới.</p>
    </div>

    <!-- Categories Horizontal Bar -->
    @await Component.InvokeAsync("Categories")

    <!-- Products List -->
    @await Html.PartialAsync("_Products", Model)
</div>

@section Scripts {
    <script src="~/js/Products/Products.js" asp-append-version="true"></script>
}
